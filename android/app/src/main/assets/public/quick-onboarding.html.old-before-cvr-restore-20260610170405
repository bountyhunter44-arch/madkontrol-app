<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kom i gang | Madkontrollen Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #eef4ee;
            --surface: #ffffff;
            --text: #162016;
            --muted: #617061;
            --border: #d7e2d7;
            --green: #2f7d32;
            --green-dark: #1e5c24;
            --green-soft: #eaf6eb;
            --red: #c0392b;
            --red-soft: #fff0ee;
            --shadow: 0 24px 60px rgba(18, 32, 18, 0.10);
            --radius-xl: 32px;
            --radius-lg: 24px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: "Inter", system-ui, sans-serif;
            color: var(--text);
            background: linear-gradient(180deg, #f8fbf8 0%, var(--bg) 100%);
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 680px;
            background: var(--surface);
            border-radius: var(--radius-xl);
            padding: 48px 40px;
            box-shadow: var(--shadow);
        }

        h1 {
            margin: 0 0 8px 0;
            font-size: 32px;
            font-weight: 800;
            color: var(--green-dark);
        }

        .subtitle {
            margin: 0 0 32px 0;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.5;
        }

        /* Progress Indicator */
        .progress-indicator {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
            position: relative;
        }

        .progress-indicator::before {
            content: '';
            position: absolute;
            top: 16px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--border);
            z-index: 0;
        }

        .progress-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            flex: 1;
            position: relative;
            z-index: 1;
        }

        .progress-step-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--surface);
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            color: var(--muted);
            transition: all 0.3s;
        }

        .progress-step.active .progress-step-circle {
            background: var(--green);
            border-color: var(--green);
            color: white;
        }

        .progress-step.completed .progress-step-circle {
            background: var(--green-soft);
            border-color: var(--green);
            color: var(--green);
        }

        .progress-step-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--muted);
            text-align: center;
        }

        .progress-step.active .progress-step-label {
            color: var(--green-dark);
        }

        /* Step Container */
        .step {
            display: none;
        }

        .step.active {
            display: block;
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .step-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--green-dark);
            margin: 0 0 24px 0;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 14px;
            color: var(--text);
        }

        input, select {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 15px;
            transition: border-color 0.2s;
            font-family: inherit;
        }

        input:focus, select:focus {
            outline: none;
            border-color: var(--green);
        }

        input[type="number"] {
            width: 100px;
        }

        .equipment-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        /* Question List */
        .question-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .question-item {
            padding: 20px;
            background: var(--green-soft);
            border-radius: 12px;
            border: 2px solid transparent;
            transition: all 0.2s;
        }

        .question-item:hover {
            border-color: var(--green);
        }

        .question-text {
            font-size: 16px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 12px;
        }

        .question-buttons {
            display: flex;
            gap: 12px;
        }

        .btn-yes,
        .btn-no {
            flex: 1;
            padding: 14px;
            border: 2px solid var(--border);
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
            color: var(--text);
        }

        .btn-yes:hover {
            border-color: var(--green);
            background: var(--green-soft);
        }

        .btn-no:hover {
            border-color: var(--muted);
            background: #f5f5f5;
        }

        .btn-yes.selected {
            background: var(--green);
            border-color: var(--green);
            color: white;
        }

        .btn-no.selected {
            background: var(--muted);
            border-color: var(--muted);
            color: white;
        }

        /* Summary */
        .summary-item {
            padding: 16px;
            background: var(--green-soft);
            border-radius: 12px;
            margin-bottom: 12px;
        }

        .summary-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: 4px;
        }

        .summary-value {
            font-size: 16px;
            font-weight: 700;
            color: var(--green-dark);
        }

        /* Buttons */
        .button-group {
            display: flex;
            gap: 12px;
            margin-top: 32px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary {
            background: var(--green);
            color: white;
        }

        .btn-primary:hover {
            background: var(--green-dark);
        }

        .btn-secondary {
            background: var(--border);
            color: var(--text);
        }

        .btn-secondary:hover {
            background: #c5d4c5;
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .error {
            background: var(--red-soft);
            color: var(--red);
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
            display: none;
        }

        .error.show {
            display: block;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 20px;
        }

        .loading.show {
            display: block;
        }

        .spinner {
            border: 3px solid var(--green-soft);
            border-top: 3px solid var(--green);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 16px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .login-link {
            text-align: center;
            margin-top: 24px;
            font-size: 14px;
            color: var(--muted);
        }

        .login-link a {
            color: var(--green);
            text-decoration: none;
            font-weight: 600;
        }

        .login-link a:hover {
            text-decoration: underline;
        }

        .prefill-badge {
            display: none;
            margin: 0 0 18px;
            padding: 10px 12px;
            border: 1px solid #b8e0c4;
            border-radius: 10px;
            background: #eefaf1;
            color: #1f6b33;
            font-size: 14px;
            font-weight: 700;
        }

        .prefill-badge.show {
            display: block;
        }

        .inline-action {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 10px;
            align-items: end;
        }

        .field-hint {
            margin-top: 6px;
            font-size: 12px;
            color: var(--muted);
        }

        .url-input {
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: center;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
            overflow: hidden;
        }

        .url-prefix {
            padding: 12px 0 12px 12px;
            color: var(--muted);
            font-weight: 700;
        }

        .url-input input {
            border: 0;
            border-radius: 0;
            padding-left: 2px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .module-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 22px;
        }

        .module-card {
            min-height: 168px;
            display: grid;
            gap: 8px;
            text-align: left;
            border: 2px solid var(--border);
            border-radius: 16px;
            background: #fff;
            padding: 16px;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s, transform 0.2s;
        }

        .module-card:hover {
            border-color: var(--green);
            transform: translateY(-1px);
        }

        .module-card.selected {
            border-color: var(--green);
            background: var(--green-soft);
        }

        .module-card.owned {
            border-color: var(--green);
            background: #f7faf7;
            cursor: default;
        }

        .module-card.owned:hover {
            transform: none;
        }

        .module-card-header {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: start;
        }

        .module-card-title {
            font-size: 17px;
            font-weight: 800;
            color: var(--green-dark);
        }

        .module-card-status {
            white-space: nowrap;
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
        }

        .module-card.selected .module-card-status {
            color: var(--green-dark);
        }

        .module-card.owned .module-card-status {
            color: var(--green-dark);
        }

        .module-card-description,
        .module-card-connection {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.4;
        }

        .module-card-price {
            font-weight: 800;
            color: var(--text);
        }

        .module-summary-list {
            margin: 0;
            padding-left: 18px;
            color: var(--text);
            line-height: 1.7;
        }

        .summary-lines {
            display: grid;
            gap: 8px;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 14px;
        }

        .summary-line strong {
            color: var(--green-dark);
        }

        .integration-list {
            margin: 8px 0 0;
            padding-left: 18px;
            color: var(--muted);
            line-height: 1.6;
        }

        .checkout-message {
            min-height: 20px;
            margin: 12px 0 0;
            color: var(--muted);
            font-size: 14px;
            font-weight: 700;
        }

        .checkout-message.warning {
            color: var(--red);
        }

        @media (max-width: 640px) {
            .inline-action {
                grid-template-columns: 1fr;
            }

            .module-grid,
            .grid-2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Kom i gang</h1>
        <p class="subtitle">Gem firmaoplysningerne som draft, så checkout og add-ons kan kobles på bagefter.</p>

        <!-- Progress Indicator -->
        <div class="progress-indicator">
            <div class="progress-step" data-step="1">
                <div class="progress-step-circle">1</div>
                <div class="progress-step-label">Firma</div>
            </div>
            <div class="progress-step" data-step="2">
                <div class="progress-step-circle">2</div>
                <div class="progress-step-label">Moduler</div>
            </div>
            <div class="progress-step" data-step="3">
                <div class="progress-step-circle">3</div>
                <div class="progress-step-label">Aktiviteter</div>
            </div>
            <div class="progress-step" data-step="4">
                <div class="progress-step-circle">4</div>
                <div class="progress-step-label">Betaling</div>
            </div>
        </div>

        <div id="errorMessage" class="error"></div>
        <div id="prefillBadge" class="prefill-badge">Udfyldt fra CRM</div>

        <!-- STEP 1: Firmaoplysninger -->
        <div class="step active" data-step="1">
            <h2 class="step-title">Firmaoplysninger</h2>

            <div class="form-group">
                <label for="cvrNumber">CVR</label>
                <div class="inline-action">
                    <input type="text" id="cvrNumber" placeholder="12345678" inputmode="numeric" autocomplete="off" maxlength="20">
                    <button type="button" class="btn btn-secondary" id="cvrLookupBtn">Hent firma fra CVR</button>
                </div>
                <div class="field-hint" id="cvrStatus">CVR-opslag henter firmaoplysninger via CVR API.</div>
            </div>
            
            <div class="form-group">
                <label for="companyName">Firmanavn</label>
                <input type="text" id="companyName" required placeholder="Fx Restaurant Madglad" autocomplete="organization">
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" required placeholder="din@email.dk" autocomplete="email">
            </div>

            <div class="form-group">
                <label for="password">Kodeord til dashboard</label>
                <input type="password" id="password" required placeholder="Mindst 8 tegn" autocomplete="new-password" minlength="8">
                <div class="field-hint">Bruges til at oprette login efter Stripe-betalingen.</div>
            </div>

            <div class="form-group">
                <label for="website">Hjemmeside</label>
                <div class="url-input">
                    <span class="url-prefix">https://</span>
                    <input type="text" id="website" placeholder="madkontrollen.dk" autocomplete="url">
                </div>
            </div>

            <div class="form-group">
                <label for="address">Adresse</label>
                <input type="text" id="address" placeholder="Gadenavn 123" autocomplete="street-address" list="addressSuggestions">
                <datalist id="addressSuggestions"></datalist>
                <div class="field-hint" id="addressStatus">Skriv adressen manuelt, eller vælg et forslag hvis autosøg finder et match.</div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label for="postalCode">Postnummer</label>
                    <input type="text" id="postalCode" placeholder="1234" autocomplete="postal-code">
                </div>

                <div class="form-group">
                    <label for="city">By</label>
                    <input type="text" id="city" placeholder="København" autocomplete="address-level2">
                </div>
            </div>

            <div class="form-group">
                <label for="phone">Telefon</label>
                <input type="tel" id="phone" placeholder="+45 12 34 56 78" autocomplete="tel">
            </div>

            <div class="form-group">
                <label for="industry">Driftstype</label>
                <select id="industry" required>
                    <option value="restaurant">Restaurant</option>
                    <option value="cafe">Café</option>
                    <option value="takeaway">Takeaway</option>
                    <option value="ice_shop">Isbutik</option>
                    <option value="bakery">Bageri</option>
                    <option value="kiosk">Kiosk</option>
                    <option value="catering">Catering</option>
                    <option value="other">Andet</option>
                </select>
            </div>
            <input type="hidden" id="industryCode">
            <input type="hidden" id="industryText">
            <input type="hidden" id="smileyUrl">
            <input type="hidden" id="controlReportUrl">
            <input type="hidden" id="crmLeadId">
            <input type="hidden" id="source">

            <div class="button-group">
                <button type="button" class="btn btn-primary" onclick="nextStep()">Fortsæt →</button>
            </div>
        </div>

        <!-- STEP 2: Modulvalg og enheder -->
        <div class="step" data-step="2">
            <h2 class="step-title">Vælg moduler</h2>
            <p class="subtitle" style="margin-top: -16px; margin-bottom: 24px;">Vælg de moduler virksomheden skal bruge. Prisen tælles sammen automatisk før betaling.</p>
            <div class="module-grid" id="moduleGrid"></div>
            <div class="summary-item">
                <div class="summary-label">Pris lige nu</div>
                <div class="summary-value" id="moduleStepTotal">Vælg mindst ét modul</div>
                <div class="field-hint" id="moduleStepVat">Nye moduler vises ekskl. moms. Egenkontrol-prisen er inkl. moms.</div>
            </div>

            <div id="moduleIntegrations" class="summary-item" hidden>
                <div class="summary-label">Mulige koblinger</div>
                <ul class="integration-list" id="moduleIntegrationList"></ul>
            </div>

            <div id="egenkontrolSetupFields">
            <h2 class="step-title" style="margin-top: 28px;">Egenkontrol: vælg enheder</h2>
            
            <div class="equipment-grid">
                <div class="form-group">
                    <label for="fridgeCount">Køleskabe</label>
                    <input type="number" id="fridgeCount" min="0" max="20" value="1">
                </div>

                <div class="form-group">
                    <label for="freezerCount">Frysere</label>
                    <input type="number" id="freezerCount" min="0" max="20" value="1">
                </div>

                <div class="form-group">
                    <label for="walkinCoolerCount">Walk-in kølere</label>
                    <input type="number" id="walkinCoolerCount" min="0" max="10" value="0">
                </div>

                <div class="form-group">
                    <label for="walkinFreezerCount">Walk-in frysere</label>
                    <input type="number" id="walkinFreezerCount" min="0" max="10" value="0">
                </div>

                <div class="form-group">
                    <label for="refrigeratedDisplayCount">Kølediske</label>
                    <input type="number" id="refrigeratedDisplayCount" min="0" max="10" value="0">
                </div>

                <div class="form-group">
                    <label for="dishwasherCount">Opvaskemaskiner</label>
                    <input type="number" id="dishwasherCount" min="0" max="5" value="0">
                </div>

                <div class="form-group">
                    <label for="fryerCount">Friturer</label>
                    <input type="number" id="fryerCount" min="0" max="5" value="0">
                </div>

                <div class="form-group">
                    <label for="ovenCount">Ovne</label>
                    <input type="number" id="ovenCount" min="0" max="10" value="0">
                </div>

                <div class="form-group">
                    <label for="stoveCount">Komfurer</label>
                    <input type="number" id="stoveCount" min="0" max="10" value="0">
                </div>

                <div class="form-group">
                    <label for="blastChillerCount">Blæsekølere</label>
                    <input type="number" id="blastChillerCount" min="0" max="5" value="0">
                </div>

                <div class="form-group">
                    <label for="hotCabinetCount">Varmeskabe</label>
                    <input type="number" id="hotCabinetCount" min="0" max="5" value="0">
                </div>

                <div class="form-group">
                    <label for="proofingCabinetCount">Rasteskabe</label>
                    <input type="number" id="proofingCabinetCount" min="0" max="5" value="0">
                </div>

                <div class="form-group">
                    <label for="smokeOvenCount">Røgeovne</label>
                    <input type="number" id="smokeOvenCount" min="0" max="5" value="0">
                </div>

                <div class="form-group">
                    <label for="slicerCount">Pålægsmaskiner</label>
                    <input type="number" id="slicerCount" min="0" max="5" value="0">
                </div>

                <div class="form-group">
                    <label for="softiceMachineCount">Softice-maskiner</label>
                    <input type="number" id="softiceMachineCount" min="0" max="5" value="0">
                </div>
            </div>
            </div>

            <div class="button-group">
                <button type="button" class="btn btn-secondary" onclick="prevStep()">← Tilbage</button>
                <button type="button" class="btn btn-primary" onclick="nextStep()">Fortsæt →</button>
            </div>
        </div>

        <!-- STEP 3: Spørgsmål -->
        <div class="step" data-step="3">
            <h2 class="step-title">Fortæl os hvad I gør i virksomheden</h2>
            <p class="subtitle" style="margin-top: -16px; margin-bottom: 24px;">Svar på spørgsmålene nedenfor, så vi kan oprette de rigtige rutiner til jer.</p>
            
            <div class="question-list">
                <div class="question-item" data-question="receivesFood">
                    <div class="question-text">Modtager I fødevarer?</div>
                    <div class="question-buttons">
                        <button type="button" class="btn-yes" data-answer="yes">Ja</button>
                        <button type="button" class="btn-no" data-answer="no">Nej</button>
                    </div>
                </div>

                <div class="question-item" data-question="coolsFood">
                    <div class="question-text">Nedkøler I fødevarer?</div>
                    <div class="question-buttons">
                        <button type="button" class="btn-yes" data-answer="yes">Ja</button>
                        <button type="button" class="btn-no" data-answer="no">Nej</button>
                    </div>
                </div>

                <div class="question-item" data-question="heatsFood">
                    <div class="question-text">Opvarmer/genopvarmer I fødevarer?</div>
                    <div class="question-buttons">
                        <button type="button" class="btn-yes" data-answer="yes">Ja</button>
                        <button type="button" class="btn-no" data-answer="no">Nej</button>
                    </div>
                </div>

                <div class="question-item" data-question="hotHolding">
                    <div class="question-text">Holder I fødevarer varme, fx i varmeskab, kogekar eller på varmeplade?</div>
                    <div class="question-buttons">
                        <button type="button" class="btn-yes" data-answer="yes">Ja</button>
                        <button type="button" class="btn-no" data-answer="no">Nej</button>
                    </div>
                </div>

                <div class="question-item" data-question="threeHourRule">
                    <div class="question-text">Har I varmebehandlede fødevarer uden køl/varme? (3-timers regel)</div>
                    <div class="question-buttons">
                        <button type="button" class="btn-yes" data-answer="yes">Ja</button>
                        <button type="button" class="btn-no" data-answer="no">Nej</button>
                    </div>
                </div>

                <div class="question-item" data-question="storesRawAndReady">
                    <div class="question-text">Opbevarer I rå og spiseklare fødevarer?</div>
                    <div class="question-buttons">
