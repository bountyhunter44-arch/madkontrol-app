        <!-- STEP 4: Opsummering -->
        <div class="step" data-step="4">
            <h2 class="step-title">Klar til oprettelse</h2>
            
            <div class="summary-item">
                <div class="summary-label">Firma</div>
                <div class="summary-value" id="summaryCompany">-</div>
            </div>

            <div class="summary-item">
                <div class="summary-label">Adresse</div>
                <div class="summary-value" id="summaryAddress">-</div>
            </div>

            <div class="summary-item">
                <div class="summary-label">Driftstype</div>
                <div class="summary-value" id="summaryIndustry">-</div>
            </div>

            <div class="summary-item">
                <div class="summary-label">Antal enheder</div>
                <div class="summary-value" id="summaryEquipment">0</div>
            </div>

            <div class="summary-item">
                <div class="summary-label">Antal aktiviteter</div>
                <div class="summary-value" id="summaryActivities">0</div>
            </div>

            <div class="summary-item">
                <div class="summary-label">Valgte moduler</div>
                <ul class="module-summary-list" id="summaryModules"></ul>
            </div>

            <div class="summary-item">
                <div class="summary-label">Prisopsummering</div>
                <div class="summary-lines" id="summaryPricing"></div>
            </div>

            <div class="summary-item" id="summaryIntegrationsWrap" hidden>
                <div class="summary-label">Modul-koblinger</div>
                <ul class="integration-list" id="summaryIntegrations"></ul>
