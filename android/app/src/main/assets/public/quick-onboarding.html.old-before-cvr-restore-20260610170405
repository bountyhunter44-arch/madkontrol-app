        <div class="login-link">
            Har du allerede en konto? <a href="/?login=1">Log ind her</a>
        </div>
    </div>

    <script type="module">
        import app from "/core/firebase-config.js";
        import { setPlatformContext } from "/platform/context-provider.js";
        import {
            calculatePlatformPricingSnapshot,
            formatDkk,
            getCheckoutModules,
            PLATFORM_MODULE_PRICING
        } from "/platform/module-pricing.js";
        import { getFunctions, httpsCallable } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-functions.js";

        const functions = getFunctions(app, "us-central1");
        const ONBOARDING_CREDENTIALS_KEY = "mkp_onboarding_credentials_v1";
        
        // State
        const state = {
            currentStep: 1,
            draftId: new URLSearchParams(window.location.search).get("draftId") || "",
            draftSource: "quick_onboarding",
            crmLeadId: "",
            selectedModules: new Set(),
            ownedModules: new Set(),
            billingInterval: "monthly",
            addressSuggestions: new Map(),
            addressSearchTimer: null
        };

        // Initialize
        updateProgressIndicator();
        setupQuestionButtons();
        setupQuickOnboarding();

        function setupQuickOnboarding() {
            document.getElementById("cvrLookupBtn")?.addEventListener("click", lookupCvrAndPrefill);
            document.getElementById("cvrNumber")?.addEventListener("blur", () => refreshOwnedModulesForCurrentForm());
            document.getElementById("email")?.addEventListener("blur", () => refreshOwnedModulesForCurrentForm());
            document.getElementById("website")?.addEventListener("input", normalizeWebsiteField);
            document.getElementById("website")?.addEventListener("blur", normalizeWebsiteField);
            document.getElementById("address")?.addEventListener("input", handleAddressInput);
            document.getElementById("address")?.addEventListener("change", applySelectedAddressSuggestion);
            const params = new URLSearchParams(window.location.search);
            const requestedSource = String(params.get("source") || "").trim();
            if (requestedSource) {
                state.draftSource = requestedSource;
                const sourceInput = document.getElementById("source");
                if (sourceInput) sourceInput.value = requestedSource;
            }
            const requestedModules = [
                params.get("module"),
                ...(params.get("modules") || "").split(",")
            ]
                .map((moduleKey) => String(moduleKey || "").trim().toLowerCase())
                .filter(Boolean);
            requestedModules.forEach((moduleKey) => {
                if (PLATFORM_MODULE_PRICING[moduleKey]) {
                    state.selectedModules.add(moduleKey);
                }
            });
            renderModuleCards();
            handleCheckoutReturnState();

            if (state.draftId) {
                loadOnboardingDraft(state.draftId);
            }
        }

        function handleCheckoutReturnState() {
            const params = new URLSearchParams(window.location.search);
            const checkout = params.get("checkout");
            if (checkout === "success") {
                showError("Tak. Dine moduler aktiveres. Du sendes videre, når betalingen er registreret.");
            } else if (checkout === "cancel") {
                showError("Betaling blev annulleret. Du kan ændre moduler og prøve igen.");
            }
        }

        function checkoutReturnPaths(selectedModules = []) {
            const params = new URLSearchParams(window.location.search);
            const source = String(params.get("source") || "").trim().toLowerCase();
            const isKoerselskontrolOnly = selectedModules.length === 1
                && selectedModules[0] === "koerselskontrol";

            if (!isKoerselskontrolOnly) return {};

            return {
                successPath: "/modules/koerselskontrol/index.html?checkout=success&session_id={CHECKOUT_SESSION_ID}",
                cancelPath: `/quick-onboarding.html?module=koerselskontrol${source ? `&source=${encodeURIComponent(source)}` : ""}&checkout=cancel`
            };
        }

        function renderModuleCards() {
            const grid = document.getElementById("moduleGrid");
            if (!grid) return;
            grid.innerHTML = getCheckoutModules().map((module) => {
                const selected = state.selectedModules.has(module.key);
                const owned = state.ownedModules.has(module.key);
                return `
                    <button type="button" class="module-card ${selected ? "selected" : ""} ${owned ? "owned" : ""}" data-module-key="${escapeHtml(module.key)}" aria-pressed="${selected ? "true" : "false"}">
                        <span class="module-card-header">
                            <span class="module-card-title">${escapeHtml(module.name)}</span>
                            <span class="module-card-status">${owned ? "Ejet" : selected ? "valgt" : "ikke valgt"}</span>
                        </span>
                        <span class="module-card-description">${escapeHtml(module.description)}</span>
                        <span class="module-card-price">${owned ? "Allerede aktivt" : escapeHtml(getModulePriceText(module))}</span>
                        <span class="module-card-connection">${escapeHtml(module.connectsWith?.length ? `Kan kobles sammen med ${module.connectsWith.join(", ")}` : "")}</span>
                    </button>
                `;
            }).join("");
            grid.querySelectorAll("[data-module-key]").forEach((button) => {
                button.addEventListener("click", () => toggleModule(button.dataset.moduleKey));
            });
            updateModuleUi();
        }

        function toggleModule(moduleKey) {
            if (!PLATFORM_MODULE_PRICING[moduleKey]) return;
            if (state.ownedModules.has(moduleKey)) return;
            if (state.selectedModules.has(moduleKey)) state.selectedModules.delete(moduleKey);
            else state.selectedModules.add(moduleKey);
            renderModuleCards();
        }

        function getSelectedModules() {
            return [...state.selectedModules].filter((moduleKey) => !state.ownedModules.has(moduleKey));
        }

        function applyOwnedModules(modules = []) {
            state.ownedModules = new Set((Array.isArray(modules) ? modules : [])
                .map((moduleKey) => String(moduleKey || "").trim().toLowerCase())
                .filter((moduleKey) => PLATFORM_MODULE_PRICING[moduleKey]));
            state.ownedModules.forEach((moduleKey) => state.selectedModules.delete(moduleKey));
            renderModuleCards();
        }

        function getModulePriceText(module) {
            if (module.taxBehavior === "inclusive") {
                return `${formatDkk(module.monthlyPriceIncVat)}/md. inkl. moms`;
            }
            return `${formatDkk(module.monthlyPriceExVat)}/md. ekskl. moms`;
        }

        function updateModuleUi() {
            const selectedModules = getSelectedModules();
            const pricing = calculatePlatformPricingSnapshot(selectedModules, state.billingInterval);
            const totalEl = document.getElementById("moduleStepTotal");
            const vatEl = document.getElementById("moduleStepVat");
            const submitBtn = document.getElementById("submitBtn");
            const checkoutMessage = document.getElementById("checkoutMessage");
            const egenkontrolSetup = document.getElementById("egenkontrolSetupFields");

            if (totalEl) {
                totalEl.textContent = selectedModules.length
                    ? `${formatDkk(pricing.totalToPayIncVat)}/md. inkl. moms`
                    : state.ownedModules.size ? "Ejet - vælg et nyt modul for at købe mere" : "Vælg mindst ét modul";
            }
            if (vatEl) {
                vatEl.textContent = pricing.inclusiveItems.length
                    ? "Egenkontrol vises særskilt som inkl. moms. Der lægges ikke moms ovenpå igen."
                    : "Nye moduler vises ekskl. moms og får moms lagt ovenpå i opsummeringen.";
            }
            if (submitBtn) submitBtn.disabled = selectedModules.length === 0;
            if (checkoutMessage) checkoutMessage.textContent = selectedModules.length
                ? ""
                : state.ownedModules.size
                    ? "Ejet-moduler springes over. Vælg et nyt modul for at gå til betaling."
                    : "Vælg mindst ét modul";
            if (egenkontrolSetup) egenkontrolSetup.hidden = !state.selectedModules.has("egenkontrol");
            renderIntegrationList("moduleIntegrationList", "moduleIntegrations");
            updateSummary();
        }

        function getSelectedIntegrationTexts() {
            const selected = state.selectedModules;
            const integrations = [];
            if (selected.has("pos") && selected.has("lagerkontrol")) integrations.push("POS kan trække fra lager");
            if (selected.has("pos") && selected.has("menu")) integrations.push("Opskrifter kan sælges i POS");
            if (selected.has("seo") && selected.has("menu")) integrations.push("Menu kan bruges i SEO");
            if (selected.has("bogforing") && selected.has("koerselskontrol")) integrations.push("Kørekontrol kan bruges i bogføring");
            return integrations;
        }

        function renderIntegrationList(listId, wrapId) {
            const list = document.getElementById(listId);
            const wrap = document.getElementById(wrapId);
            if (!list || !wrap) return;
            const integrations = getSelectedIntegrationTexts();
            wrap.hidden = integrations.length === 0;
            list.innerHTML = integrations.map((text) => `<li>${escapeHtml(text)}</li>`).join("");
        }

        async function loadOnboardingDraft(draftId) {
            try {
                const getOnboardingDraft = httpsCallable(functions, "getOnboardingDraft");
                const result = await getOnboardingDraft({ draftId });
                const draft = unwrapOnboardingDraft(result.data);
                if (!result.data?.ok || !draft) {
                    showError("Onboarding draft blev ikke fundet. Du kan fortsætte med en tom formular.");
                    return;
                }

                state.draftSource = draft.source || "crm";
                state.crmLeadId = draft.crmLeadId || "";
                const prefilledFields = applyDraftToForm(draft);
                state.selectedModules = new Set(Array.isArray(draft.selectedModules) ? draft.selectedModules : []);
                if (Array.isArray(draft.activeModules)) {
                    applyOwnedModules(draft.activeModules);
                }
                renderModuleCards();
                refreshOwnedModulesForCurrentForm();
                document.getElementById("prefillBadge")?.classList.add("show");
                console.log("[quick onboarding] draft loaded", { draftId, keys: Object.keys(draft || {}) });
                console.log("[quick onboarding] prefilled fields:", prefilledFields.join(", "));
            } catch (error) {
                console.error("[quick onboarding] draft load failed", error);
                showError("Kunne ikke hente onboarding draft. Du kan fortsætte manuelt.");
            }
        }

        function unwrapOnboardingDraft(response) {
            const raw = response?.draft || response?.data || response?.payload || response || {};
            const nested = raw?.data || raw?.draft || raw?.profile || raw?.company || {};
            return {
                ...(raw?.data || {}),
                ...(raw?.profile || {}),
                ...(raw?.company || {}),
                ...(typeof nested === "object" ? nested : {}),
                ...(typeof raw === "object" ? raw : {})
            };
        }

        function applyDraftToForm(draft) {
            const filled = [];
            setFieldValue(["cvrNumber", "cvr", "cvrnr"], draft.cvrNumber || draft.cvr || "", filled);
            setFieldValue(["companyName", "name", "firmaNavn", "businessName"], firstText(draft.companyName, draft.name, draft.businessName, draft.legalName, draft.virksomhed, draft.navn), filled);
            setFieldValue(["address", "adresse", "street"], draft.address || draft.street || "", filled);
            setFieldValue(["postalCode", "postnummer", "zip"], draft.postalCode || draft.zip || "", filled);
            setFieldValue(["city", "by"], draft.city || draft.by || "", filled);
            setFieldValue(["phone", "telefon", "tlf"], draft.phone || draft.phoneNumber || "", filled);
            setFieldValue(["email", "accountEmail", "mail"], draft.email || draft.accountEmail || "", filled);
            setFieldValue(["website", "hjemmeside", "url"], normalizeWebsiteDomain(draft.website || draft.websiteUrl || ""), filled);
            setFieldValue(["industryCode", "branchekode"], draft.industryCode || "", filled);
            setFieldValue(["industryText", "branchetekst", "industry"], draft.industryText || draft.industry || "", filled);
            setFieldValue(["smileyUrl", "smiley", "smileyLink"], draft.smileyUrl || draft.controlReportUrl || "", filled);
            setFieldValue(["controlReportUrl", "kontrolrapportUrl", "controlReportLink"], draft.controlReportUrl || draft.smileyUrl || "", filled);
            setFieldValue(["crmLeadId", "leadId"], draft.crmLeadId || "", filled);
            setFieldValue(["source"], draft.source || state.draftSource || "", filled);
            setIndustryFromText(draft.industryText || draft.industry || "");
            return filled;
        }

        function setFieldValue(fieldNames, value, filledFields = []) {
            if (value === undefined || value === null || String(value).trim() === "") return false;
            const names = Array.isArray(fieldNames) ? fieldNames : [fieldNames];
            for (const name of names) {
                const field = findFormField(name);
                if (!field) continue;
                field.value = String(value);
                filledFields.push(field.id || field.name || field.dataset.field || name);
                return true;
            }
            return false;
        }

        function findFormField(name) {
            const key = String(name || "").trim();
            if (!key) return null;
            return document.getElementById(key)
                || document.querySelector(`[name="${escapeAttributeValue(key)}"]`)
                || document.querySelector(`[data-field="${escapeAttributeValue(key)}"]`);
        }

        function escapeAttributeValue(value) {
            return String(value || "").replace(/\\/g, "\\\\").replace(/"/g, '\\"');
        }

        function escapeHtml(value) {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function setIndustryFromText(value) {
            const text = String(value || "").toLowerCase();
            const select = document.getElementById("industry");
            if (!select) return;
            if (text.includes("cafe") || text.includes("café")) select.value = "cafe";
            else if (text.includes("takeaway")) select.value = "takeaway";
            else if (text.includes("is")) select.value = "ice_shop";
            else if (text.includes("bager")) select.value = "bakery";
            else if (text.includes("kiosk")) select.value = "kiosk";
            else if (text.includes("catering")) select.value = "catering";
            else if (text.includes("restaurant")) select.value = "restaurant";
        }

        async function lookupCvrAndPrefill() {
            const cvrInput = document.getElementById("cvrNumber");
            const normalizedCvr = normalizeCvrInput(cvrInput.value);
            const status = document.getElementById("cvrStatus");
            cvrInput.value = normalizedCvr;

            if (!/^\d{8}$/.test(normalizedCvr)) {
                status.textContent = "CVR skal være 8 cifre.";
                showError("CVR skal være 8 cifre.");
                return;
            }

            hideError();
            status.textContent = "Henter firma fra CVR...";
            console.log("[quick onboarding] normalized cvr", normalizedCvr);

            try {
                const response = await fetch(`https://cvrapi.dk/api?search=${normalizedCvr}&country=dk`, {
                    headers: { "User-Agent": "Madkontrollen - kontakt@madkontrollen.dk" }
                });

                if (!response.ok) throw new Error(`CVR API svarede med ${response.status}`);
                const company = await response.json();
                if (company.error) throw new Error(company.error);

                applyDraftToForm({
                    cvrNumber: normalizedCvr,
                    companyName: firstText(company.companyName, company.name, company.virksomhed, company.navn, company.legalName, company?.company?.name, company?.company?.companyName),
                    address: company.address,
                    postalCode: company.postalCode || company.zip || company.zipcode,
                    city: company.city,
                    phone: company.phone,
                    email: company.email,
                    website: company.website,
                    industryCode: company.industryCode || company.industrycode,
                    industryText: company.industryText || company.industry || company.industrydesc || company.companydesc
                });
                await refreshOwnedModulesForCurrentForm();

                status.textContent = "Firmaoplysninger hentet fra CVR.";
                console.log("[quick onboarding] cvr_lookup_completed", normalizedCvr);
            } catch (error) {
                console.error("[quick onboarding] cvr lookup failed", error);
                status.textContent = "CVR kunne ikke hentes.";
                showError(error?.message || "CVR blev ikke fundet.");
            }
        }

        async function refreshOwnedModulesForCurrentForm() {
            const cvr = normalizeCvrInput(document.getElementById("cvrNumber")?.value || "");
            const email = String(document.getElementById("email")?.value || "").trim().toLowerCase();
            const companyName = String(document.getElementById("companyName")?.value || "").trim();

            if (!cvr && !email && !companyName) return;

            try {
                const lookupCompanyModuleOwnership = httpsCallable(functions, "lookupCompanyModuleOwnership");
                const result = await lookupCompanyModuleOwnership({
                    cvr,
                    email,
                    companyName,
                    address: document.getElementById("address")?.value || "",
                    postalCode: document.getElementById("postalCode")?.value || "",
                    city: document.getElementById("city")?.value || ""
                });
                const ownedModules = result.data?.ownedModules || result.data?.activeModules || [];
                applyOwnedModules(ownedModules);
            } catch (error) {
                console.warn("[quick onboarding] owned module lookup failed", error);
            }
        }

        function handleAddressInput(event) {
            const query = String(event.target.value || "").trim();
            window.clearTimeout(state.addressSearchTimer);

            if (query.length < 3) {
                return;
            }

            state.addressSearchTimer = window.setTimeout(() => searchAddressSuggestions(query), 250);
        }

        async function searchAddressSuggestions(query) {
            const status = document.getElementById("addressStatus");
            try {
                const response = await fetch(`https://api.dataforsyningen.dk/adresser/autocomplete?q=${encodeURIComponent(query)}&per_side=6`);
                if (!response.ok) throw new Error("address_lookup_failed");
                const results = await response.json();
                const list = document.getElementById("addressSuggestions");
                list.innerHTML = "";
                state.addressSuggestions.clear();

                (Array.isArray(results) ? results : []).forEach(item => {
                    const text = item?.tekst || item?.adresse?.betegnelse || "";
                    if (!text) return;
                    const option = document.createElement("option");
                    option.value = text;
                    list.appendChild(option);
                    state.addressSuggestions.set(text, item);
                });

                status.textContent = results?.length ? "Vælg et adresseforslag, eller skriv manuelt." : "Ingen adresseforslag fundet. Skriv manuelt.";
            } catch (error) {
                console.warn("[quick onboarding] address autocomplete unavailable", error);
                status.textContent = "Adresse-autosøg er ikke tilgængelig lige nu. Skriv adressen manuelt.";
            }
        }

        function applySelectedAddressSuggestion() {
            const value = document.getElementById("address").value;
            const selected = state.addressSuggestions.get(value);
            if (!selected?.adresse) return;
            const address = selected.adresse;

            setFieldValue("address", address.vejnavn && address.husnr ? `${address.vejnavn} ${address.husnr}` : value);
            setFieldValue("postalCode", address.postnr || "");
            setFieldValue("city", address.postnrnavn || "");
            console.log("[quick onboarding] address_autocomplete_selected");
        }

        // Navigation
        window.nextStep = function() {
            if (state.currentStep === 1) {
                if (!validateStep1()) return;
            }

            if (state.currentStep === 2 && !validateModuleSelection()) {
                return;
            }
            
            if (state.currentStep < 4) {
                state.currentStep = state.currentStep === 2 && !state.selectedModules.has("egenkontrol")
                    ? 4
                    : state.currentStep + 1;
                showStep(state.currentStep);
                
                if (state.currentStep === 4) {
                    updateSummary();
                }
            }
        };

        window.prevStep = function() {
            if (state.currentStep > 1) {
                state.currentStep = state.currentStep === 4 && !state.selectedModules.has("egenkontrol")
                    ? 2
                    : state.currentStep - 1;
                showStep(state.currentStep);
            }
        };

        function showStep(step) {
            document.querySelectorAll('.step').forEach(el => {
                el.classList.remove('active');
            });
            
            document.querySelector(`.step[data-step="${step}"]`).classList.add('active');
            updateProgressIndicator();
            window.scrollTo(0, 0);
        }

        function updateProgressIndicator() {
            document.querySelectorAll('.progress-step').forEach(el => {
                const stepNum = parseInt(el.dataset.step);
                el.classList.remove('active', 'completed');
                
                if (stepNum === state.currentStep) {
                    el.classList.add('active');
                } else if (stepNum < state.currentStep) {
                    el.classList.add('completed');
                }
            });
        }

        function validateStep1() {
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;
            const companyName = document.getElementById('companyName').value.trim();

            if (!email || !password || !companyName) {
                showError("Udfyld venligst alle påkrævede felter.");
                return false;
            }

            if (password.length < 8) {
                showError("Kodeordet skal være mindst 8 tegn.");
                return false;
            }

            hideError();
            return true;
        }

        function validateModuleSelection() {
            if (getSelectedModules().length === 0) {
                showError(state.ownedModules.size
                    ? "Ejet-moduler springes over. Vælg et nyt modul for at gå til betaling."
                    : "Vælg mindst ét modul");
                return false;
            }
            hideError();
            return true;
        }

        function setupQuestionButtons() {
            document.querySelectorAll('.question-item').forEach(item => {
                const yesBtn = item.querySelector('.btn-yes');
                const noBtn = item.querySelector('.btn-no');
                
                yesBtn.addEventListener('click', () => {
                    yesBtn.classList.add('selected');
                    noBtn.classList.remove('selected');
                });
                
                noBtn.addEventListener('click', () => {
                    noBtn.classList.add('selected');
                    yesBtn.classList.remove('selected');
                });
            });
        }

        function updateSummary() {
            // Company
            const companyName = document.getElementById('companyName').value.trim();
            document.getElementById('summaryCompany').textContent = companyName || '-';

            // Address
            const address = document.getElementById('address').value.trim();
            const postalCode = document.getElementById('postalCode').value.trim();
            const city = document.getElementById('city').value.trim();
            const fullAddress = [address, postalCode, city].filter(Boolean).join(', ') || '-';
            document.getElementById('summaryAddress').textContent = fullAddress;

            // Industry
            const industry = document.getElementById('industry').value;
            const industryLabels = {
                restaurant: 'Restaurant',
                cafe: 'Café',
                takeaway: 'Takeaway',
                ice_shop: 'Isbutik',
                bakery: 'Bageri',
                kiosk: 'Kiosk',
                catering: 'Catering',
                other: 'Andet'
            };
            document.getElementById('summaryIndustry').textContent = industryLabels[industry] || industry;

            // Equipment count
            const equipmentCount = [
                'fridgeCount', 'freezerCount', 'walkinCoolerCount', 'walkinFreezerCount',
                'refrigeratedDisplayCount', 'dishwasherCount', 'fryerCount', 'ovenCount',
                'stoveCount', 'blastChillerCount', 'hotCabinetCount', 'proofingCabinetCount',
                'smokeOvenCount', 'slicerCount', 'softiceMachineCount'
            ].reduce((sum, id) => sum + (parseInt(document.getElementById(id).value) || 0), 0);
            document.getElementById('summaryEquipment').textContent = state.selectedModules.has("egenkontrol") ? equipmentCount : "Ikke valgt";

            // Activities count (count "Ja" answers)
            const activitiesCount = document.querySelectorAll('.btn-yes.selected').length;
            document.getElementById('summaryActivities').textContent = state.selectedModules.has("egenkontrol") ? activitiesCount : "Ikke valgt";

            const selectedModules = getSelectedModules();
            const pricing = calculatePlatformPricingSnapshot(selectedModules, state.billingInterval);
            const modulesEl = document.getElementById("summaryModules");
            const pricingEl = document.getElementById("summaryPricing");
            if (modulesEl) {
                modulesEl.innerHTML = selectedModules.length
                    ? selectedModules.map((moduleKey) => {
                        const module = PLATFORM_MODULE_PRICING[moduleKey];
                        return `<li>${escapeHtml(module.name)}: ${escapeHtml(getModulePriceText(module))}</li>`;
                    }).join("")
                    : "<li>Vælg mindst ét modul</li>";
            }
            if (pricingEl) {
                pricingEl.innerHTML = `
                    ${pricing.exclusiveItems.length ? `<div class="summary-line"><span>Subtotal ekskl. moms</span><strong>${formatDkk(pricing.subtotalExVat)}/md.</strong></div>` : ""}
                    ${pricing.exclusiveItems.length ? `<div class="summary-line"><span>Moms 25%</span><strong>${formatDkk(pricing.vatAmount)}</strong></div>` : ""}
                    ${pricing.exclusiveItems.length ? `<div class="summary-line"><span>Total nye moduler inkl. moms</span><strong>${formatDkk(pricing.totalIncVat)}/md.</strong></div>` : ""}
                    ${pricing.inclusiveItems.map((item) => `<div class="summary-line"><span>${escapeHtml(item.name)} inkl. moms</span><strong>${formatDkk(item.amountIncVat)}/${pricing.billingInterval === "yearly" ? "år" : "md."}</strong></div>`).join("")}
                    <div class="summary-line"><span>Total til betaling inkl. moms</span><strong>${formatDkk(pricing.totalToPayIncVat)}/${pricing.billingInterval === "yearly" ? "år" : "md."}</strong></div>
                `;
            }
            renderIntegrationList("summaryIntegrations", "summaryIntegrationsWrap");
            const submitBtn = document.getElementById("submitBtn");
            const checkoutMessage = document.getElementById("checkoutMessage");
            if (submitBtn) submitBtn.disabled = selectedModules.length === 0;
            if (checkoutMessage) checkoutMessage.textContent = selectedModules.length
                ? ""
                : state.ownedModules.size
                    ? "Ejet-moduler springes over. Vælg et nyt modul for at gå til betaling."
                    : "Vælg mindst ét modul";
        }

        window.submitForm = async function() {
            hideError();
            if (!validateStep1()) return;
            if (!validateModuleSelection()) return;
            showLoading();

            try {
                // Collect data
                const email = document.getElementById('email').value.trim().toLowerCase();
                const password = document.getElementById('password').value;
                const cvrNumber = normalizeCvrInput(document.getElementById('cvrNumber').value);
                document.getElementById('cvrNumber').value = cvrNumber;
                const companyName = firstText(document.getElementById('companyName').value);
                const address = document.getElementById('address').value.trim();
                const postalCode = document.getElementById('postalCode').value.trim();
                const city = document.getElementById('city').value.trim();
                const phone = document.getElementById('phone').value.trim();
                const website = normalizeWebsiteUrl(document.getElementById('website').value);
                const industry = document.getElementById('industry').value;
                const industryCode = document.getElementById('industryCode').value.trim();
                const industryText = document.getElementById('industryText').value.trim();
                const smileyUrl = document.getElementById('smileyUrl').value.trim();
                const controlReportUrl = document.getElementById('controlReportUrl').value.trim();
                const crmLeadId = document.getElementById('crmLeadId').value.trim() || state.crmLeadId || "";
                const source = document.getElementById('source').value.trim() || state.draftSource || "quick_onboarding";
                const selectedModules = getSelectedModules();

                // Collect questions
                const questions = {};
                document.querySelectorAll('.question-item').forEach(item => {
                    const questionKey = item.dataset.question;
                    const yesBtn = item.querySelector('.btn-yes');
                    questions[questionKey] = yesBtn.classList.contains('selected');
                });

                // Build setup
                const setup = {
                    industry,
                    // Equipment counts
                    fridgeCount: parseInt(document.getElementById('fridgeCount').value) || 0,
                    freezerCount: parseInt(document.getElementById('freezerCount').value) || 0,
                    walkinCoolerCount: parseInt(document.getElementById('walkinCoolerCount').value) || 0,
                    walkinFreezerCount: parseInt(document.getElementById('walkinFreezerCount').value) || 0,
                    refrigeratedDisplayCount: parseInt(document.getElementById('refrigeratedDisplayCount').value) || 0,
                    dishwasherCount: parseInt(document.getElementById('dishwasherCount').value) || 0,
                    fryerCount: parseInt(document.getElementById('fryerCount').value) || 0,
                    ovenCount: parseInt(document.getElementById('ovenCount').value) || 0,
                    stoveCount: parseInt(document.getElementById('stoveCount').value) || 0,
                    blastChillerCount: parseInt(document.getElementById('blastChillerCount').value) || 0,
                    hotCabinetCount: parseInt(document.getElementById('hotCabinetCount').value) || 0,
                    proofingCabinetCount: parseInt(document.getElementById('proofingCabinetCount').value) || 0,
                    smokeOvenCount: parseInt(document.getElementById('smokeOvenCount').value) || 0,
                    slicerCount: parseInt(document.getElementById('slicerCount').value) || 0,
                    softiceMachineCount: parseInt(document.getElementById('softiceMachineCount').value) || 0,
                    // Questions (Ja/Nej answers)
                    questions: questions
                };

                const payload = {
                    source,
                    crmLeadId,
                    cvrNumber,
                    cvr: cvrNumber,
                    companyName,
                    name: companyName,
                    address,
                    postalCode,
                    zip: postalCode,
                    city,
                    phone,
                    email,
                    accountEmail: email,
                    accountPassword: password,
                    website,
                    smileyUrl,
                    controlReportUrl: controlReportUrl || smileyUrl,
                    industry,
                    industryCode,
                    industryText,
                    selectedModules,
                    plan: "pro",
                    billingInterval: state.billingInterval,
                    status: "draft",
                    company: {
                        cvr: cvrNumber,
                        cvrNumber,
                        name: companyName,
                        companyName,
                        phone,
                        email,
                        accountEmail: email,
                        accountPassword: password,
                        address,
                        postalCode,
                        zip: postalCode,
                        city,
                        industryCode,
                        industryText
                    },
                    profile: {
                        companyName,
                        cvr: cvrNumber,
                        phone,
                        address,
                        zip: postalCode,
                        city,
                        accountEmail: email,
                        accountPassword: password,
                        website
                    },
                    setup
                };

                console.debug("[quick onboarding] saveOnboardingDraft canonical", JSON.stringify({
                    companyName: payload.companyName,
                    cvr: payload.cvr,
                    name: payload.name,
                    company: payload.company,
                    selectedModules: payload.selectedModules
                }, null, 2));
                console.log("[quick onboarding] saveOnboardingDraft payload", payload);

                const saveOnboardingDraft = httpsCallable(functions, "saveOnboardingDraft");
                const result = await saveOnboardingDraft({
                    draftId: state.draftId || "",
                    ...payload
                });
                const draftId = result.data?.draftId;
                if (!draftId) throw new Error("Draft blev gemt, men draftId manglede i svaret.");
                state.draftId = draftId;
                const companyContext = {
                    source: "quick-onboarding",
                    draftId,
                    companyName,
                    cvr: cvrNumber,
                    address,
                    postalCode,
                    city,
                    phone,
                    email,
                    industryCode,
                    industryText,
                    selectedModules: payload.selectedModules
                };
                setPlatformContext(companyContext);
                sessionStorage.setItem("mkp_quick_onboarding_company_profile", JSON.stringify(companyContext));
                localStorage.setItem("mkp_quick_onboarding_company_profile", JSON.stringify(companyContext));
                localStorage.setItem(ONBOARDING_CREDENTIALS_KEY, JSON.stringify({
                    email,
                    password
                }));

                console.log("[quick onboarding] quick_onboarding_draft_saved", draftId);
                const createCheckout = httpsCallable(functions, "createPlatformCheckoutSession");
                const checkout = await createCheckout({
                    draftId,
                    selectedModules,
                    billingInterval: state.billingInterval,
                    ...checkoutReturnPaths(selectedModules)
                });
                const checkoutUrl = checkout.data?.url;
                if (!checkoutUrl) throw new Error("Checkout URL mangler fra backend.");
                window.location.href = checkoutUrl;

            } catch (error) {
                console.error('[Quick Onboarding] Error:', error);
                hideLoading();

                let errorMsg = 'Der opstod en fejl. Prøv igen.';
                if (error.code === 'already-exists') {
                    errorMsg = 'Denne email er allerede i brug.';
                } else if (error.message) {
                    errorMsg = error.message;
                }

                showError(errorMsg);
            }
        };

        function showError(message) {
            const errorEl = document.getElementById('errorMessage');
            errorEl.textContent = message;
            errorEl.classList.add('show');
        }

        function hideError() {
            document.getElementById('errorMessage').classList.remove('show');
        }

        function normalizeCvrInput(value) {
            return String(value || "")
                .replace(/\bCVR\b/gi, "")
                .replace(/\bDK\b/gi, "")
                .replace(/\D/g, "")
                .slice(0, 8);
        }

        function firstText(...values) {
            for (const value of values) {
                const text = String(value || "").trim();
                if (text) return text;
            }
            return "";
        }

        function normalizeWebsiteDomain(value) {
            return String(value || "")
                .trim()
                .replace(/^https?:\/\//i, "")
                .replace(/^\/+/, "");
        }

        function normalizeWebsiteUrl(value) {
            const domain = normalizeWebsiteDomain(value);
            return domain ? `https://${domain}` : "";
        }

        function normalizeWebsiteField(event) {
            const input = event.currentTarget;
            const normalized = normalizeWebsiteDomain(input.value);
            if (input.value !== normalized) input.value = normalized;
        }

        function showLoading() {
            document.querySelectorAll('.step').forEach(el => el.style.display = 'none');
            document.getElementById('loadingIndicator').classList.add('show');
        }

        function hideLoading() {
            showStep(state.currentStep);
            document.getElementById('loadingIndicator').classList.remove('show');
        }
    </script>
</body>
</html>
