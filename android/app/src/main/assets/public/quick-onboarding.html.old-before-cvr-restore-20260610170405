            <p class="checkout-message warning" id="checkoutMessage"></p>

            <div class="button-group">
                <button type="button" class="btn btn-secondary" onclick="prevStep()">← Tilbage</button>
                <button type="button" class="btn btn-primary" onclick="submitForm()" id="submitBtn">Fortsæt til betaling</button>
