{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
    "target": "madkontrollen",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/dashbord",
        "destination": "/dashboard",
        "type": 301
      },
      {
        "source": "/dashbord.html",
        "destination": "/dashboard",
        "type": 301
      },
      {
        "source": "/modules/egenkontrol/front.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/modules/egenkontrol/front",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/funktioner/digital-egenkontrol.html",
        "destination": "/digital-egenkontrol/",
        "type": 301
      },
      {
        "source": "/funktioner/risikoanalyse-haccp.html",
        "destination": "/risikoanalyse-haccp/",
        "type": 301
      },
      {
        "source": "/egenkontrol-restaurant",
        "destination": "/egenkontrol-restaurant/",
        "type": 301
      },
      {
        "source": "/egenkontrol-takeaway",
        "destination": "/egenkontrol-takeaway/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/admin/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      },
      {
        "source": "/modules/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      },
      {
        "source": "/dashboard{,/**,.html}",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      },
      {
        "source": "/{login,quick-onboarding,onboarding,tak,create-company,create-location}.html",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      },
      {
        "source": "/{core,platform,sso}/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "upgrade-insecure-requests"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/dashboard.html",
        "destination": "/dashboard.html"
      },
      {
        "source": "/tak",
        "destination": "/tak.html"
      },
      {
        "source": "/tak.html",
        "destination": "/tak.html"
      },
      {
        "source": "/privatlivspolitik",
        "destination": "/privatlivspolitik.html"
      },
      {
        "source": "/vilkaar-og-betingelser",
        "destination": "/vilkaar-og-betingelser.html"
      },
      {
        "source": "/cookie-indstillinger",
        "destination": "/cookie-indstillinger.html"
      },
      {
        "source": "/gdpr",
        "destination": "/gdpr.html"
      },
      {
        "source": "/landing",
        "destination": "/index.html"
      },
      {
        "source": "/digital-egenkontrol/**",
        "destination": "/funktioner/digital-egenkontrol.html"
      },
      {
        "source": "/risikoanalyse-haccp/**",
        "destination": "/funktioner/risikoanalyse-haccp.html"
      },
      {
        "source": "/fn/saveRoutineTask",
        "function": "saveRoutineTask"
      },
      {
        "source": "/fn/getDashboardSnapshot",
        "function": "getDashboardSnapshot"
      },
      {
        "source": "/fn/seedDemoData",
        "function": "seedDemoData"
      },
      {
        "source": "/fn/resetDemoData",
        "function": "resetDemoData"
      },
      {
        "source": "/fn/getCloudinarySignature",
        "function": "getCloudinarySignature"
      },
      {
        "source": "/fn/analyzeCloudinaryAsset",
        "function": "analyzeCloudinaryAsset"
      },
      {
        "source": "/fn/getCloudinaryAssets",
        "function": "getCloudinaryAssets"
      },
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
